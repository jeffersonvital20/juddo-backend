# ============================================================================
# JUDOO BACKEND - EXEMPLO DE VARIÁVEIS DE AMBIENTE (.env.example)
# Copie este arquivo para .env.development, .env.staging ou .env.production
# ============================================================================

# Ambiente de Execução (Development, Staging, Production)
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
API_PORT=8080

# Banco de Dados PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=judoo_db
POSTGRES_USER=judoo_user
POSTGRES_PASSWORD=your_secure_db_password_here
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=judoo_db;Username=judoo_user;Password=your_secure_db_password_here;

# Autenticação JWT (Chave com no mínimo 32 caracteres)
Jwt__Key=YourSuperSecretKeyForJwtAuthentication32CharsLong!
Jwt__Issuer=Judoo.Api
Jwt__Audience=Judoo.Clients

# CORS (origens separadas por vírgula em produção)
Cors__AllowAnyOrigin=true
# Cors__AllowedOrigins__0=http://localhost:3000
# Cors__AllowedOrigins__1=http://localhost:5173

# Documentação Swagger & Seeds de Demonstração
Swagger__Enabled=true
Swagger__RoutePrefix=
Security__SeedDemoUsers=true
